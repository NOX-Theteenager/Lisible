# Copiez ce fichier en .env puis renseignez vos clés. Ne publiez jamais le fichier .env.

PORT=3000

# Google Gemini : analyse d'offres, import de CV, réécritures, entretien, traduction
# Clé : https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Délai avant de basculer sur Claude si Gemini ne répond pas (ms)
GEMINI_TIMEOUT_MS=45000

# Anthropic Claude : rédaction des lettres de motivation
# Clé : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Supabase : comptes, base de données, liens de relecture
# Project Settings → Data API : « Project URL »
# Project Settings → API Keys : « Publishable key » (sb_publishable_…) ou, dans l'onglet « Legacy API keys », la clé « anon public »
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Requêtes IA par minute (invités / utilisateurs connectés)
RATE_LIMIT_GUEST=15
RATE_LIMIT_USER=60
